# Telegram Bot API Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Optional: Comma-separated Telegram User IDs for superadmins who can run commands anywhere (even in DMs)
# You can find your user ID using @userinfobot or the /myinfo command once running
SUPERADMIN_IDS=

# Database path (optional, defaults to bot.db in the project folder)
DB_PATH=bot.db
